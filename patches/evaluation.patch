diff --git a/run-toolchain-groups.py b/run-toolchain-groups.py
new file mode 100755
index 0000000..43591e9
--- /dev/null
+++ b/run-toolchain-groups.py
@@ -0,0 +1,160 @@
+#!/usr/bin/env python3
+"""Run the AMi evaluation once for each named compiler toolchain."""
+
+import argparse
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+
+
+def default_groups(evaluation_dir):
+    repository_dir = evaluation_dir.parent
+    return [
+        ("author", repository_dir / "toolchain/install/bin"),
+        ("ghost-fixed", repository_dir.parent /
+         "llvm-project-ami-cfl/install/bin"),
+    ]
+
+
+def parse_group(spec):
+    name, separator, directory = spec.partition("=")
+    if not separator or not name or not directory:
+        raise ValueError("expected NAME=TOOLCHAIN_DIR, got %r" % spec)
+    return name, Path(directory).expanduser().resolve()
+
+
+def parse_groups(evaluation_dir, specs):
+    if specs:
+        return [parse_group(spec) for spec in specs]
+
+    environment_specs = os.environ.get("TOOLCHAIN_GROUPS")
+    if environment_specs:
+        return [parse_group(spec) for spec in environment_specs.split(",")]
+
+    return default_groups(evaluation_dir)
+
+
+def run(command, evaluation_dir, environment):
+    print("$ %s" % " ".join(command), flush=True)
+    return subprocess.run(command, cwd=evaluation_dir,
+                          env=environment).returncode
+
+
+def copy_results(evaluation_dir, output_dir):
+    output_dir.mkdir(parents=True, exist_ok=True)
+    for report_name in ("report.csv", "results.tex", "results.html"):
+        source = evaluation_dir / report_name
+        if source.exists():
+            shutil.copy2(source, output_dir / report_name)
+
+    results_dir = output_dir / "results"
+    for benchmark_dir in sorted(evaluation_dir.iterdir()):
+        if not benchmark_dir.is_dir():
+            continue
+        result_files = sorted(benchmark_dir.glob("*.results"))
+        if not result_files:
+            continue
+        destination = results_dir / benchmark_dir.name
+        destination.mkdir(parents=True, exist_ok=True)
+        for result_file in result_files:
+            shutil.copy2(result_file, destination / result_file.name)
+
+
+def write_metadata(output_dir, name, toolchain_dir, build_core, core):
+    clang = toolchain_dir / "clang"
+    version = subprocess.run([str(clang), "--version"],
+                             check=False, capture_output=True, text=True)
+    source_dir = toolchain_dir.parent.parent
+    revision = subprocess.run(
+        ["git", "-C", str(source_dir), "rev-parse", "HEAD"],
+        check=False, capture_output=True, text=True)
+    version_lines = version.stdout.splitlines()
+    source_revision = revision.stdout.strip() or "unknown"
+    metadata = [
+        "group=%s" % name,
+        "toolchain_dir=%s" % toolchain_dir,
+        "build_core=%s" % build_core,
+        "core=%s" % core,
+        "source_git=%s" % source_revision,
+        "clang_version=%s" % (version_lines[0] if version_lines
+                               else "unknown"),
+    ]
+    (output_dir / "metadata.txt").write_text("\n".join(metadata) + "\n")
+
+
+def main():
+    evaluation_dir = Path(__file__).resolve().parent
+    parser = argparse.ArgumentParser(
+        description="Run the AMi benchmark suite for multiple compiler groups")
+    parser.add_argument(
+        "--group", action="append", metavar="NAME=TOOLCHAIN_DIR",
+        help="override the default groups; may be specified more than once")
+    parser.add_argument(
+        "--output-dir", default=str(evaluation_dir / "compiler-groups"),
+        help="directory in which per-group reports are saved")
+    parser.add_argument(
+        "--build-core", choices=("0", "1"),
+        default=os.environ.get("BUILD_CORE", "1"),
+        help="whether each benchmark may rebuild the Proteus simulator")
+    parser.add_argument(
+        "--core", default=os.environ.get("CORE", "riscv.CoreExtMem"),
+        help="Proteus core passed to the benchmark Makefiles")
+    args = parser.parse_args()
+
+    try:
+        groups = parse_groups(evaluation_dir, args.group)
+    except ValueError as error:
+        parser.error(str(error))
+
+    output_root = Path(args.output_dir).expanduser().resolve()
+    output_root.mkdir(parents=True, exist_ok=True)
+    failures = []
+    ran_groups = 0
+
+    for name, toolchain_dir in groups:
+        clang = toolchain_dir / "clang"
+        group_output = output_root / name
+        if not clang.is_file() or not os.access(clang, os.X_OK):
+            print("SKIP %s: missing executable %s" % (name, clang),
+                  file=sys.stderr)
+            continue
+
+        ran_groups += 1
+        environment = os.environ.copy()
+        environment["TOOLCHAIN_DIR"] = str(toolchain_dir)
+        environment["BUILD_CORE"] = args.build_core
+        environment["CORE"] = args.core
+        environment.setdefault("MPLBACKEND", "Agg")
+
+        print("\n=== compiler group: %s ===" % name, flush=True)
+        clean_status = run(["make", "realclean"], evaluation_dir, environment)
+        if clean_status != 0:
+            failures.append((name, "realclean", clean_status))
+            continue
+
+        try:
+            status = run(["make"], evaluation_dir, environment)
+            if status != 0:
+                failures.append((name, "evaluation", status))
+                continue
+            copy_results(evaluation_dir, group_output)
+            write_metadata(group_output, name, toolchain_dir,
+                           args.build_core, args.core)
+        finally:
+            run(["make", "realclean"], evaluation_dir, environment)
+
+    if not ran_groups:
+        print("No compiler groups were runnable", file=sys.stderr)
+        return 1
+    if failures:
+        for name, phase, status in failures:
+            print("FAILED %s (%s): exit %d" % (name, phase, status),
+                  file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
